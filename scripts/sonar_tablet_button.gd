## Pixel field-tablet toggle button (Godot 4), from tools/make_sonar_tablet.py and art/sonar_tablet_sheet.png. Idle it shows a colour terrain map; clicking flips the screen
## to a black-and-green sonar sweep, clicking again flips back.
##
## It is a rad_meter_button.gd with the tablet's own frames (same signals, set_on(), `turn`, hover outline, pixel hit area, on_sound and off_sound): the base class asks
## `_get_anims()` which frame table to play. In the top bar it is the switch between the map's clean pixel art (off) and its text glyphs (on).
extends "res://scripts/rad_meter_button.gd"

# --- FRAMES BEGIN (generated by make_sonar_tablet.py: [x, y, ms]) ---
const TABLET_ANIMS := {
	"off": {"loop": false, "frames": [
		[0, 0, 1000],
	]},
	"power_on": {"loop": false, "frames": [
		[0, 64, 60], [40, 64, 45], [80, 64, 45], [120, 64, 40],
		[160, 64, 45], [200, 64, 45], [240, 64, 60], [280, 64, 70],
		[320, 64, 70], [360, 64, 70], [400, 64, 70],
	]},
	"on": {"loop": true, "frames": [
		[0, 128, 90], [40, 128, 90], [80, 128, 90], [120, 128, 90],
		[160, 128, 90], [200, 128, 90], [240, 128, 90], [280, 128, 90],
		[320, 128, 90], [360, 128, 90], [400, 128, 90], [440, 128, 90],
		[480, 128, 90], [520, 128, 90], [560, 128, 90], [600, 128, 90],
	]},
	"power_off": {"loop": false, "frames": [
		[0, 192, 60], [40, 192, 45], [80, 192, 45], [120, 192, 45],
		[160, 192, 40], [200, 192, 45], [240, 192, 45], [280, 192, 80],
	]},
}
# --- FRAMES END ---


func _get_anims() -> Dictionary:
	return TABLET_ANIMS
