## Pixel END SEASON window button (Godot 4): the artist's salvaged window over the wasteland, from tools/make_end_season.py and art/end_season_sheet.png (64 x 40, the same
## pixel style as the radiation meter and the field tablet).
##
## The window shows the sky the game is in: the day (sun high) in a day season, the night (moon up, stars, a campfire) in a night season. Clicking it asks for the end of the
## season (`clicked`) and the game then tells the window where the sky is heading with go_to(): the sun sets into the night, or the dawn brings the day back, stretched to the
## seconds the map takes to fade, and a door click sounds when it has finished. Only the window's own pixels are clickable, not the empty corners.
##
##   window.clicked.connect(end_the_season)
##   window.go_to(true, 3.0)        # sunset over three seconds, then the night loop
##   window.set_night(false)        # found in daylight, as after a load: no animation
##
## Set `sheet` and `pixel_scale` before the window goes into the tree: the frames are built once, in _ready.
extends Control

## Emitted the moment the player clicks the window.
signal clicked
## Emitted when the sunset or the dawn (or the press, with the sky unchanged) has finished playing. `night` is the sky the window rests on now.
signal settled(night: bool)

@export var sheet: Texture2D
## Screen pixels to a pixel of the art: whole numbers keep every pixel square, a fraction (the top bar draws this window at 1.2) makes some of them a little wider.
@export_range(1.0, 8.0, 0.05) var pixel_scale: float = 3.0:
	set(value):
		pixel_scale = value
		_apply_scale()
## Optional: the door click that plays once the window has finished its sunset or dawn (or its press), as if the shutter had latched.
@export var latch_sound: AudioStream
@export_range(-40.0, 6.0) var sound_volume_db := -6.0
## The audio bus the click plays on ("Master" unless a game wants its own, like a music volume slider).
@export var sound_bus: StringName = &"Master"

const FRAME_W := 64
const FRAME_H := 40
const HOVER_CELL := Vector2i(64, 0)
## The press when the sky does not change (the night is switched off): the window's first sunset frame, which has the whole window pushed down a pixel, held this long.
const PRESS_MS := 110

# --- FRAMES BEGIN (generated by make_end_season.py: [x, y, ms]) ---
const ANIMS := {
	"day": {"loop": false, "frames": [
		[0, 0, 1000],
	]},
	"end_season": {"loop": false, "frames": [
		[0, 40, 60], [64, 40, 70], [128, 40, 70], [192, 40, 70],
		[256, 40, 70], [320, 40, 70], [384, 40, 80], [448, 40, 90],
		[512, 40, 90], [576, 40, 90], [640, 40, 90], [704, 40, 90],
		[768, 40, 80], [832, 40, 80], [896, 40, 80], [960, 40, 90],
		[1024, 40, 120],
	]},
	"night": {"loop": true, "frames": [
		[0, 80, 150], [64, 80, 150], [128, 80, 150], [192, 80, 150],
		[256, 80, 150], [320, 80, 150],
	]},
	"new_day": {"loop": false, "frames": [
		[0, 120, 90], [64, 120, 90], [128, 120, 90], [192, 120, 80],
		[256, 120, 80], [320, 120, 70], [384, 120, 70], [448, 120, 70],
		[512, 120, 80], [576, 120, 100],
	]},
}
# --- FRAMES END ---

## The sky the window shows now, or is heading for while it plays.
var is_night := false
var _busy := false
var _hovered := false
var _sprite: AnimatedSprite2D
var _outline: Sprite2D
var _sfx: AudioStreamPlayer
var _hit: BitMap


func _ready() -> void:
	if sheet == null:
		push_error("EndSeasonButton: assign end_season_sheet.png to 'sheet'.")
		return
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	mouse_filter = Control.MOUSE_FILTER_STOP
	mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	focus_mode = Control.FOCUS_NONE   # Space and Enter belong to the die and the walk: a focused window must never end a season on them (E does it from the keyboard)

	_sprite = AnimatedSprite2D.new()
	_sprite.centered = false
	_sprite.sprite_frames = _build_frames()
	add_child(_sprite)

	_outline = Sprite2D.new()
	_outline.centered = false
	var outline_tex := AtlasTexture.new()
	outline_tex.atlas = sheet
	outline_tex.region = Rect2(HOVER_CELL.x, HOVER_CELL.y, FRAME_W, FRAME_H)
	_outline.texture = outline_tex
	_outline.visible = false
	add_child(_outline)

	_sfx = AudioStreamPlayer.new()
	_sfx.bus = sound_bus
	add_child(_sfx)

	_build_hit_mask()
	_apply_scale()

	_sprite.animation_finished.connect(_on_animation_finished)
	mouse_entered.connect(_on_mouse_entered)
	mouse_exited.connect(_on_mouse_exited)

	set_night(is_night)


## Whether a change of sky (or a press) is playing.
func is_busy() -> bool:
	return _busy


## The animation that is playing now, or the one the window rests on.
func current_animation() -> StringName:
	return _sprite.animation if _sprite != null else &""


## Puts the window on the day or the night at once, without playing the change (a new game, a load, the Night switch).
func set_night(value: bool) -> void:
	is_night = value
	_busy = false
	if _sprite == null:
		return
	_sprite.speed_scale = 1.0
	_sprite.play("night" if is_night else "day")
	_update_outline()


## Plays the sky changing to the night (the sun sets, the moon rises) or to the day (the dawn), stretched to `seconds` so it ends as the map's fade does (0 plays it at the artist's
## speed). A change still playing lands first. If the sky is already the one asked for, the window just takes a press.
func go_to(night: bool, seconds := 0.0) -> void:
	if _sprite == null:
		is_night = night
		return
	if _busy:
		set_night(is_night)
	if night == is_night:
		_press()
		return
	is_night = night
	_busy = true
	var anim := "end_season" if night else "new_day"
	_sprite.speed_scale = _length_seconds(anim) / seconds if seconds > 0.0 else 1.0
	_sprite.play(anim)
	_update_outline()


## The window pushed in for a moment, on the sky it has.
func _press() -> void:
	_busy = true
	_sprite.speed_scale = 1.0
	_sprite.play("press")
	_update_outline()


## How long an animation takes at the artist's speed, in seconds.
func _length_seconds(anim: String) -> float:
	var total := 0.0
	for f in ANIMS[anim]["frames"]:
		total += float(f[2])
	return total / 1000.0


func _gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
		clicked.emit()
		accept_event()


func _has_point(point: Vector2) -> bool:
	var p := Vector2i(point / pixel_scale)
	if p.x < 0 or p.y < 0 or p.x >= FRAME_W or p.y >= FRAME_H:
		return false
	if _hit == null:
		return true
	return _hit.get_bitv(p)


func _on_animation_finished() -> void:
	var anim := _sprite.animation
	if anim == &"end_season" or anim == &"new_day" or anim == &"press":
		_busy = false
		_sprite.speed_scale = 1.0
		_sprite.play("night" if is_night else "day")
		_update_outline()
		if latch_sound != null and _sfx != null:
			_sfx.stream = latch_sound
			_sfx.volume_db = sound_volume_db
			_sfx.play()
		settled.emit(is_night)


func _build_frames() -> SpriteFrames:
	var frames := SpriteFrames.new()
	frames.remove_animation(&"default")
	for anim_name in ANIMS:
		var anim: Dictionary = ANIMS[anim_name]
		frames.add_animation(anim_name)
		frames.set_animation_loop(anim_name, anim["loop"])
		# Frame durations are stored in milliseconds, so 1000 "fps" makes 1 unit = 1 ms.
		frames.set_animation_speed(anim_name, 1000.0)
		for f in anim["frames"]:
			frames.add_frame(anim_name, _frame_texture(f[0], f[1]), float(f[2]))
	frames.add_animation(&"press")
	frames.set_animation_loop(&"press", false)
	frames.set_animation_speed(&"press", 1000.0)
	frames.add_frame(&"press", _frame_texture(0, FRAME_H), float(PRESS_MS))
	return frames


func _frame_texture(x: int, y: int) -> AtlasTexture:
	var tex := AtlasTexture.new()
	tex.atlas = sheet
	tex.region = Rect2(x, y, FRAME_W, FRAME_H)
	return tex


func _build_hit_mask() -> void:
	var img := sheet.get_image()
	if img == null:
		return
	if img.is_compressed():
		img.decompress()
	_hit = BitMap.new()
	# Threshold 0.5 counts the window's solid pixels but not its soft ground shadow.
	_hit.create_from_image_alpha(img.get_region(Rect2i(0, 0, FRAME_W, FRAME_H)), 0.5)


func _apply_scale() -> void:
	custom_minimum_size = Vector2(FRAME_W, FRAME_H) * pixel_scale
	size = custom_minimum_size
	if _sprite:
		_sprite.scale = Vector2.ONE * pixel_scale
		_outline.scale = _sprite.scale


func _on_mouse_entered() -> void:
	_hovered = true
	_update_outline()


func _on_mouse_exited() -> void:
	_hovered = false
	_update_outline()


func _update_outline() -> void:
	if _outline:
		_outline.visible = _hovered and not _busy
