## Pixel radiation-meter toggle button (Godot 4): the artist's meter, from tools/make_rad_meter.py and art/rad_meter_sheet.png.
##
## Clicking the meter (or ui_accept while it has focus) switches it on or off and plays the power animations. Only the meter's own pixels are clickable, not the empty
## corners. The sheet is 40 x 64 frames drawn upright; `turn` lays the meter on its side (every frame and the clickable shape are turned) so it fits a bar.
##
##   meter.switched.connect(func(on): print("meter on: ", on))
##   meter.set_on(true, true)   # restore from a save without animating
##
## Set `sheet`, `turn` and `pixel_scale` before the meter goes into the tree: the frames are built once, in _ready.
extends Control

## Emitted the moment the player flips the switch.
signal switched(is_on: bool)
## Emitted when the power-on / power-off animation has finished.
signal settled(is_on: bool)

@export var sheet: Texture2D
@export_range(1, 8) var pixel_scale: int = 3:
	set(value):
		pixel_scale = value
		_apply_scale()
## How the picture is laid: upright (40 x 64), or a quarter turn to one side (64 x 40).
@export_enum("Upright", "Clockwise", "Anticlockwise") var turn: int = 0:
	set(value):
		turn = value
		_apply_scale()
@export var start_on := false
## Optional: plays on each selector-knob detent.
@export var click_sound: AudioStream
## Optional: plays when the meter is pressed.
@export var press_sound: AudioStream

const FRAME_W := 40
const FRAME_H := 64
const HOVER_CELL := Vector2i(40, 0)

# --- FRAMES BEGIN (generated by make_rad_meter.py: [x, y, ms, detent]) ---
const ANIMS := {
	"off": {"loop": false, "frames": [
		[0, 0, 1000, 0],
	]},
	"power_on": {"loop": false, "frames": [
		[0, 64, 60, 0], [40, 64, 70, 1], [80, 64, 70, 1], [120, 64, 60, 1],
		[160, 64, 50, 0], [200, 64, 50, 0], [240, 64, 70, 0], [280, 64, 50, 0],
		[320, 64, 50, 0], [360, 64, 60, 0], [400, 64, 60, 0], [440, 64, 70, 0],
		[480, 64, 80, 0], [520, 64, 100, 0],
	]},
	"on": {"loop": true, "frames": [
		[0, 128, 160, 0], [40, 128, 140, 0], [80, 128, 180, 0], [120, 128, 120, 0],
		[160, 128, 70, 0], [200, 128, 160, 0], [240, 128, 200, 0], [280, 128, 150, 0],
	]},
	"power_off": {"loop": false, "frames": [
		[0, 192, 60, 0], [40, 192, 70, 1], [80, 192, 70, 1], [120, 192, 70, 1],
		[160, 192, 60, 0], [200, 192, 60, 0], [240, 192, 120, 0],
	]},
}
# --- FRAMES END ---

var is_on := false
var _busy := false
var _hovered := false
var _sprite: AnimatedSprite2D
var _outline: Sprite2D
var _sfx: AudioStreamPlayer
var _hit: BitMap
var _atlas: Texture2D   # the sheet as laid out for `turn`: every 40 x 64 cell turned into a 64 x 40 one


func _ready() -> void:
	if sheet == null:
		push_error("RadMeterButton: assign rad_meter_sheet.png to 'sheet'.")
		return
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	mouse_filter = Control.MOUSE_FILTER_STOP
	mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	focus_mode = Control.FOCUS_ALL
	var image := _laid_out_sheet()
	_atlas = ImageTexture.create_from_image(image)

	_sprite = AnimatedSprite2D.new()
	_sprite.centered = false
	_sprite.sprite_frames = _build_frames()
	add_child(_sprite)

	_outline = Sprite2D.new()
	_outline.centered = false
	var outline_tex := AtlasTexture.new()
	outline_tex.atlas = _atlas
	outline_tex.region = _cell_rect(HOVER_CELL.x, HOVER_CELL.y)
	_outline.texture = outline_tex
	_outline.visible = false
	add_child(_outline)

	_sfx = AudioStreamPlayer.new()
	add_child(_sfx)

	_build_hit_mask(image)
	_apply_scale()

	_sprite.animation_finished.connect(_on_animation_finished)
	_sprite.frame_changed.connect(_on_frame_changed)
	mouse_entered.connect(_on_mouse_entered)
	mouse_exited.connect(_on_mouse_exited)
	focus_entered.connect(_update_outline)
	focus_exited.connect(_update_outline)

	set_on(start_on, true)


## The size of one frame as drawn: 40 x 64, or 64 x 40 when the meter lies on its side.
func cell_size() -> Vector2i:
	return Vector2i(FRAME_H, FRAME_W) if turn != 0 else Vector2i(FRAME_W, FRAME_H)


## Whether a power animation is playing (a click does nothing until it finishes).
func is_busy() -> bool:
	return _busy


func toggle() -> void:
	if _busy:
		return
	set_on(not is_on)


func set_on(value: bool, instant := false) -> void:
	is_on = value
	if _sprite == null:
		return
	if instant:
		_busy = false
		_sprite.play("on" if is_on else "off")
	else:
		_busy = true
		_sprite.play("power_on" if is_on else "power_off")
		_play_sound(press_sound)
		switched.emit(is_on)
	_update_outline()


func _gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
		toggle()
		accept_event()
		release_focus.call_deferred()   # a click does not leave the keyboard outline on (Tab still brings it)
	elif event.is_action_pressed("ui_accept"):
		toggle()
		accept_event()


func _has_point(point: Vector2) -> bool:
	var p := Vector2i(point / float(pixel_scale))
	var cell := cell_size()
	if p.x < 0 or p.y < 0 or p.x >= cell.x or p.y >= cell.y:
		return false
	if _hit == null:
		return true
	return _hit.get_bitv(p)


## The sheet, with each frame turned to suit `turn` (a plain copy when upright). Frames keep their place in the grid.
func _laid_out_sheet() -> Image:
	var source := sheet.get_image()
	if source.is_compressed():
		source.decompress()
	source.convert(Image.FORMAT_RGBA8)
	if turn == 0:
		return source
	var cell := cell_size()
	var cols := source.get_width() / FRAME_W
	var rows := source.get_height() / FRAME_H
	var laid := Image.create(cols * cell.x, rows * cell.y, false, Image.FORMAT_RGBA8)
	for row in rows:
		for col in cols:
			var frame := source.get_region(Rect2i(col * FRAME_W, row * FRAME_H, FRAME_W, FRAME_H))
			frame.rotate_90(CLOCKWISE if turn == 1 else COUNTERCLOCKWISE)
			laid.blit_rect(frame, Rect2i(Vector2i.ZERO, cell), Vector2i(col * cell.x, row * cell.y))
	return laid


## Where the frame whose top left is (x, y) on the upright sheet sits on the laid-out one.
func _cell_rect(x: int, y: int) -> Rect2:
	var cell := cell_size()
	return Rect2(Vector2i(x / FRAME_W, y / FRAME_H) * cell, cell)


func _build_frames() -> SpriteFrames:
	var frames := SpriteFrames.new()
	frames.remove_animation(&"default")
	for anim_name in ANIMS:
		var anim: Dictionary = ANIMS[anim_name]
		frames.add_animation(anim_name)
		frames.set_animation_loop(anim_name, anim["loop"])
		# Frame durations are stored in milliseconds, so 1000 "fps" makes 1 unit = 1 ms.
		frames.set_animation_speed(anim_name, 1000.0)
		for f in anim["frames"]:
			var tex := AtlasTexture.new()
			tex.atlas = _atlas
			tex.region = _cell_rect(f[0], f[1])
			frames.add_frame(anim_name, tex, float(f[2]))
	return frames


func _build_hit_mask(image: Image) -> void:
	_hit = BitMap.new()
	# Threshold 0.5 counts the meter's solid pixels but not its soft ground shadow.
	_hit.create_from_image_alpha(image.get_region(Rect2i(Vector2i.ZERO, cell_size())), 0.5)


func _apply_scale() -> void:
	custom_minimum_size = Vector2(cell_size()) * pixel_scale
	size = custom_minimum_size
	if _sprite:
		_sprite.scale = Vector2.ONE * pixel_scale
		_outline.scale = _sprite.scale


func _on_animation_finished() -> void:
	var anim := _sprite.animation
	if anim == &"power_on" or anim == &"power_off":
		_busy = false
		_sprite.play("on" if is_on else "off")
		_update_outline()
		settled.emit(is_on)


func _on_frame_changed() -> void:
	var anim: Dictionary = ANIMS.get(String(_sprite.animation), {})
	if anim.is_empty() or _sprite.frame >= anim["frames"].size():
		return
	if anim["frames"][_sprite.frame][3] == 1:
		_play_sound(click_sound)


func _play_sound(stream: AudioStream) -> void:
	if stream and _sfx:
		_sfx.stream = stream
		_sfx.play()


func _on_mouse_entered() -> void:
	_hovered = true
	_update_outline()


func _on_mouse_exited() -> void:
	_hovered = false
	_update_outline()


func _update_outline() -> void:
	if _outline:
		_outline.visible = (_hovered or has_focus()) and not _busy
